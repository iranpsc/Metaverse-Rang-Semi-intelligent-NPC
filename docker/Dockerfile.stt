FROM python:3.11.16-slim-bookworm AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git && rm -rf /var/lib/apt/lists/*
COPY requirements requirements
RUN pip wheel --wheel-dir /wheels -r requirements/stt.txt

FROM python:3.11.16-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app && useradd --system --gid app --home /app app
COPY --from=builder /wheels /wheels
COPY requirements requirements
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements/stt.txt && rm -rf /wheels
WORKDIR /app
COPY --chown=app:app pipeline_core pipeline_core
COPY --chown=app:app services services
COPY --chown=root:root docker/stt-entrypoint.sh /usr/local/bin/stt-entrypoint
RUN chmod 0755 /usr/local/bin/stt-entrypoint
EXPOSE 5001
ENTRYPOINT ["/usr/local/bin/stt-entrypoint"]
CMD ["uvicorn", "services.stt_server:app", "--host", "0.0.0.0", "--port", "5001", "--no-access-log", "--limit-concurrency", "32"]
