FROM python:3.11.16-slim-bookworm

ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu118
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/opt/openvoice \
    TORCH_HOME=/tmp/torch \
    NUMBA_CACHE_DIR=/tmp/numba-cache \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10
RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app && useradd --system --gid app --home /app app
WORKDIR /app
COPY VC/requirements.txt /tmp/vc-requirements.txt
COPY requirements/vc-observability.txt /tmp/vc-observability.txt
RUN pip install --no-cache-dir torch==2.5.1 --index-url ${PYTORCH_INDEX_URL} \
    && pip install --no-cache-dir -r /tmp/vc-requirements.txt -r /tmp/vc-observability.txt
COPY --chown=app:app pipeline_core pipeline_core
COPY --chown=app:app third_party/openvoice/openvoice /opt/openvoice/openvoice
COPY --chown=app:app third_party/openvoice/LICENSE /opt/openvoice/LICENSE
COPY --chown=app:app VC/vc_server.py VC/openvoice_runtime.py VC/
RUN mkdir -p /tmp/torch /tmp/numba-cache \
    && chown -R app:app /tmp/torch /tmp/numba-cache
USER app
EXPOSE 5003
CMD ["python", "VC/vc_server.py"]
