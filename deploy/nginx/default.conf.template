map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${API_DOMAIN} ${LIVEKIT_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${API_DOMAIN};
    ssl_certificate /certs/api/fullchain.pem;
    ssl_certificate_key /certs/api/privkey.pem;

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl http2;
    server_name ${LIVEKIT_DOMAIN};
    ssl_certificate /certs/livekit/fullchain.pem;
    ssl_certificate_key /certs/livekit/privkey.pem;

    location / {
        proxy_pass http://${LIVEKIT_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}
