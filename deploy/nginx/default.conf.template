map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${API_DOMAIN} ${LIVEKIT_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${API_DOMAIN};
    # Allow the app's 25 MiB recordings plus multipart form overhead.
    client_max_body_size 26m;
    ssl_certificate /certs/api/fullchain.pem;
    ssl_certificate_key /certs/api/privkey.pem;

    location /media/voice_samples/ {
        alias /app/media/voice_samples/;
        types {
            audio/wav wav;
            audio/webm webm;
            audio/ogg ogg;
            audio/mpeg mp3;
            audio/mp4 m4a;
            audio/flac flac;
        }
        add_header X-Content-Type-Options nosniff;
    }

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl http2;
    server_name ${LIVEKIT_DOMAIN};
    ssl_certificate /certs/livekit/fullchain.pem;
    ssl_certificate_key /certs/livekit/privkey.pem;

    location / {
        proxy_pass http://${LIVEKIT_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}
