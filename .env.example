# Copy to .env. Never commit the populated file.

# LiveKit credentials: API secret must be at least 32 random characters.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=ad9a46860efb2f7bc40ec4f798186749a4fa5fabd928e566d91c9f8381ba52cb
LIVEKIT_AGENT_NAME=metarang-agent
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_TOKEN_TTL_SECONDS=600

# Django control plane. Replace the secret and disable debug in production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,npc.metarang.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:8000,https://npc.metarang.com
DJANGO_PORT=8000
VECTOR_STORE_MAX_FILES=10
VECTOR_STORE_MAX_RSS_LINKS=10
VECTOR_STORE_MAX_UPLOAD_BYTES=26214400
VOICE_SAMPLE_MAX_UPLOAD_BYTES=26214400
VOICE_SAMPLE_MIN_DURATION_SECONDS=1
VOICE_SAMPLE_MAX_DURATION_SECONDS=60
VOICE_SAMPLE_MIN_VOICED_SECONDS=0.8
VOICE_SAMPLE_PROCESSING_TIMEOUT_SECONDS=30
VC_SAMPLE_VALIDATION_TIMEOUT_SECONDS=3

# AI models. Paths are host paths mounted read-only into containers.
WHISPER_MODEL=large
# The single STT microservice serves LiveKit, /record/, and the WebSocket test page.
# Django itself does not receive GPU access or load a second Whisper instance.
WHISPER_DEVICE=cuda
EMBEDDING_MODEL_PATH_HOST=/home/npc/Documents/Fine-tune-LLM/models/sentence_embeddings
LLM_MODEL=dorna2
LLM_USE_GPU=true
TTS_MODEL_DIR_HOST=./TTS/models/mana
TTS_CPU_THREADS=4
# Offline speech normalization. Custom entries override the bundled lexicon.
TTS_DIACRITIZATION=lexicon
TTS_PRONUNCIATION_DIR_HOST=./TTS/pronunciation
TTS_MAX_NORMALIZED_TEXT_LENGTH=12000
VC_CHECKPOINT_DIR_HOST=./VC/checkpoints/openvoice-v2
# One P40 was verified on this host, so index 0 is unambiguous inside the container.
VC_GPU_DEVICE=0

# Pipeline concurrency, endpointing, and failure policy.
STT_QUEUE_SIZE=8
STT_INFERENCE_WORKERS=1
STT_TIMEOUT_SECONDS=120
TTS_TIMEOUT_SECONDS=120
VC_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_STREAM_QUEUE_SIZE=32
LLM_TIMEOUT_SECONDS=180
LLM_OPERATION_TIMEOUT_SECONDS=600
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
REDIS_SOCKET_TIMEOUT_SECONDS=5
SPEECH_THRESHOLD_DBFS=38
SPEECH_END_SILENCE_MS=900
SENTENCE_QUEUE_SIZE=2
PARTICIPANT_WAIT_TIMEOUT_SECONDS=45
VC_FAILURE_FALLBACK=false
SPEECH_JOB_RETENTION_SECONDS=3600
SPEECH_TEXT_MAX_LENGTH=2000
VC_MAX_CONCURRENT_REQUESTS=1
VC_QUEUE_MAX_SIZE=4
VC_QUEUE_TIMEOUT_SECONDS=30
VC_TARGET_CACHE_MAX_ENTRIES=32
VC_TARGET_CACHE_TTL_SECONDS=1800
# Measured OpenVoice peak (253 MiB) plus the 512 MiB safety margin on Tesla P40.
VC_MIN_FREE_VRAM_MB=765
VC_VRAM_SAFETY_MARGIN_MB=512
VC_MODEL_RETRY_COOLDOWN_SECONDS=30
VC_MIN_VOICED_SECONDS=0.8

# Local observability. Change Grafana credentials outside development.
LOG_LEVEL=INFO
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091

# Production-only networking and TLS (used with docker-compose.prod.yml).
API_DOMAIN=npc.metarang.com
LIVEKIT_DOMAIN=livekit.example.com
LIVEKIT_TURN_DOMAIN=turn.example.com
# Required for remote WebRTC clients; leave empty only for localhost-only use.
LIVEKIT_NODE_IP=
TLS_CERTS_DIR=./certs
